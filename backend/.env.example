# Rahgir backend — copy to .env and fill in.
# BYO-LLM + free geo/routing keys.

# OpenRouteService — https://openrouteservice.org/dev/#/signup (free 2000 req/day)
ORS_API_KEY=

# --- POI provider: "otm" (free, default) or "google" (paid, richer coverage) ---
POI_PROVIDER=otm

# OpenTripMap — https://opentripmap.io/product   (used when POI_PROVIDER=otm)
OTM_API_KEY=

# Google Places (New) — https://developers.google.com/maps/documentation/places/web-service
# Needs billing enabled. Used when POI_PROVIDER=google. Caching keeps cost low.
GOOGLE_PLACES_API_KEY=
POI_PHOTOS=true       # fetch photo refs (Google only) for the Famous-For cards

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Pipeline tuning
SAMPLE_KM=25          # distance between sampled waypoints
POI_RADIUS_M=8000     # POI search radius around each waypoint
POI_MIN_RATE=2        # OpenTripMap importance threshold (1..3)
POI_PER_WAYPOINT=10   # max POIs fetched per waypoint
MAX_RANKED=12         # itinerary size

# --- Production: caching + safety ---
# Redis makes the cache + trip store shared across workers and restart-safe.
# Leave empty for dev (in-process fallback is used automatically).
REDIS_URL=            # e.g. redis://localhost:6379/0

# Comma-separated allowed origins in production (default "*" for dev).
# CORS_ORIGINS=*        # e.g. https://rahgir.app,https://www.rahgir.app

# Per-IP rate limits (slowapi syntax).
RATE_LIMIT_TRIP=20/minute
RATE_LIMIT_DEFAULT=120/minute
